# Copy this to .env and fill in real values. Never commit the real .env.

# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/cityops
# Supabase (prod): get from Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cityops

GROQ_API_KEY=
CHROMA_PERSIST_DIR=./chroma_store

RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@cityops.local

ENV=development
CORS_ORIGINS=["http://localhost:3000"]

CONFLICT_BUFFER_METERS=5.0
